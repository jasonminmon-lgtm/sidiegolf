leUp\",\"dur\":4,\"desc\":\"All games combine into one Settle Up screen: one number each.\"},{\"name\":\"Settle\",\"dur\":3,\"desc\":\"Camera pushes in on Caddie holding the calculator while Let us settle slams in.\"},{\"name\":\"Close\",\"dur\":5,\"desc\":\"End card: logo, Free at sidiegolf.com, Try it this weekend, and a scan-to-start code.\"}]';<\u002Fscript>\n<script>window.OM_PLAYBACK = '{\"mode\":\"once\"}';<\u002Fscript>\n<script>window.TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{\n  \"motionEditor\": true\n}/*EDITMODE-END*/;<\u002Fscript>\n<\u002Fhelmet>\n<x-import component-from-global-scope=\"SidieVideo\" from=\"f5decf77-b010-4413-aa79-f47be86baefd#/animations-v3.jsx f32ac7a4-6f84-4d9d-b933-3e412daf466e#/tweaks-panel.jsx 937719a8-14b8-4e36-b4ae-1baa18a4b929#/sidie-scenes-standalone.jsx\" hint-size=\"100%,100%\"><\u002Fx-import>\n<\u002Fx-dc>\n\n\n<\u002Fbody><\u002Fhtml>"
